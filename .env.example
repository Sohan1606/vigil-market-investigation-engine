# VIGIL environment — copy to .env (never commit .env)
VIGIL_MODE=DEMO
VIGIL_CONFIG=config/vigil.yaml
# Optional real infrastructure. When unset, VIGIL uses documented local fallbacks.
MONGODB_URI=
KAFKA_BOOTSTRAP_SERVERS=
HDFS_URI=
JAVA_HOME=
VIGIL_API_HOST=0.0.0.0
VIGIL_API_PORT=8000
VIGIL_CORS_ORIGINS=http://localhost:8000
VIGIL_LOG_LEVEL=INFO
